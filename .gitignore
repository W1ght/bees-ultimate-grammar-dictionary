# Build outputs
/build/
/dist/
/out/
*.zip
SHA256SUMS

# PUBLIC build tree. Every one of these is regenerated by `make public` from the
# same locked bytes, so committing them would only create a second copy that can
# drift from the pipeline's actual output. `data/extracted-public/` in particular
# is the redistribution filter's RESULT, not an input: it must always be derived
# from `data/extracted/` by the current filter, never read from a stale checkout,
# or a source that loses its grant keeps shipping from a leftover file.
/build-public/
/dist-public/
/data/extracted-public/
/data/merge-public/
/data/merged-public/

# Acquired / extracted source data (regenerable, large, possibly non-redistributable)
/data/sources/*/*
!/data/sources/.gitkeep
# ...but the digest manifests ARE the reproducibility contract and must ship: they
# pin every acquired byte by sha256 + byteCount + upstream URL, plus the licence
# tier and redistributable flag LICENSING.md and any publish step depend on. They
# are small (100K total) and carry no source content, only hashes. Without them a
# clean clone cannot verify that a re-acquisition produced the same bytes the
# dictionary was built from.
!/data/sources/*/SOURCE.lock.json
/data/extracted/
/data/merged/
# Derived merge artifacts (regenerated by `make keymap` + `make merge`)
/data/merge/keymap.json
/data/merge/unified.jsonl
/data/merge/unified.stats.json
/data/merge/AMBIGUITY.md
# ...and the two reports the merge target's audits emit. Same class: derived from
# the same locked bytes on every run, so a committed copy can only drift.
/data/merge/reading_audit.json
/data/merge/reading_disagreements_resolved.json
/data/merge/attribution_precision.json
/cache/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/

# Kanban board bookkeeping (card-id map), not part of the dictionary source
/.card_ids.json
