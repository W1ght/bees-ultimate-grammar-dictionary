# Build outputs
/build/
# `/dist/*`, not `/dist/`: git does not descend into an excluded DIRECTORY, so a
# directory pattern makes the negation below unreachable.
/dist/*
/out/
*.zip
SHA256SUMS
# ...except the published index. The archive's own `indexUrl` points at this
# file on the default branch, so an update checker can read the current
# revision without downloading the whole dictionary. It is ~700 bytes and it is
# the one build output that has to be fetchable from the repository itself.
!/dist/index.json

# Acquired / extracted source data (regenerable and large)
/data/sources/*/*
!/data/sources/.gitkeep
# ...but the digest manifests ARE the reproducibility contract and must ship: they
# pin every acquired byte by sha256 + byteCount + upstream URL. They are small
# (100K total) and carry no source content, only hashes. Without them a clean
# clone cannot verify that a re-acquisition produced the same bytes the dictionary
# was built from.
!/data/sources/*/SOURCE.lock.json
/data/extracted/
/data/merged/
# Derived merge artifacts (regenerated by `make keymap` + `make merge`)
/data/merge/keymap.json
/data/merge/unified.jsonl
/data/merge/unified.stats.json
/data/merge/AMBIGUITY.md
# ...and the two reports the merge target's audits emit. Same class: derived from
# the same locked bytes on every run, so a committed copy can only drift.
/data/merge/reading_audit.json
/data/merge/reading_disagreements_resolved.json
/data/merge/attribution_precision.json
/data/merge/attribution_coherence.json
/cache/

# A local Yomitan checkout, unpacked for the real-host card harness. It is
# upstream's published build, pinned by the digests in `schemas/`, not ours to
# carry: 169k lines of vendored HTML/JS would swamp every diff in this repo.
/vendor/

# Python
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/

# Kanban board bookkeeping (card-id map), not part of the dictionary source
/.card_ids.json
