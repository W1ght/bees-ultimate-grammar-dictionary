# Build outputs
/build/
/dist/
/out/
*.zip
SHA256SUMS

# Acquired / extracted source data (regenerable, large, possibly non-redistributable)
/data/sources/*/
!/data/sources/.gitkeep
/data/extracted/
/data/merged/
